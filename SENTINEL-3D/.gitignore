# SENTINEL-3D .gitignore

# ── Build artifacts ────────────────────────────────────────────────────────────
build/
dist/
*.o
*.so
*.dll
*.dylib
*.exe
*.out
*.a
*.lib

# ── C++/CUDA build files ───────────────────────────────────────────────────────
backend/cpp_cuda/build/
backend/cpp_cuda/cmake-build-*/
*.cmake
CMakeCache.txt
CMakeFiles/

# ── Python ─────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
ENV/
env/
*.egg-info/
.pytest_cache/
.mypy_cache/

# ── Node.js / Frontend ─────────────────────────────────────────────────────────
node_modules/
.next/
out/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.DS_Store
*.tsbuildinfo
next-env.d.ts

# ── Dataset & Model Weights (Large Files) ──────────────────────────────────────
data/
*.bin
*.pth
*.pt
weights/
!weights/.gitkeep

# ── IDE & Editor ───────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.project
.classpath
.settings/

# ── OS ─────────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# ── Logs ───────────────────────────────────────────────────────────────────────
logs/
*.log

# ── Temporary Files ────────────────────────────────────────────────────────────
tmp/
temp/
*.tmp
*.bak
*.cache

# ── LibTorch / Third-party Dependencies ────────────────────────────────────────
backend/cpp_cuda/third_party/uWebSockets/
backend/cpp_cuda/third_party/uSockets/
backend/cpp_cuda/third_party/pybind11/
libtorch/

# ── Environment & Secrets ──────────────────────────────────────────────────────
.env
.env.local
.env.production
*.key
*.pem
*.crt
secrets/
